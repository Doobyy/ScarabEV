# Copy to `backend/.dev.vars` for local development.
# Do not commit the real .dev.vars file.
APP_NAME=scarabev-backend
APP_ENV=dev
LOG_LEVEL=debug
OBS_SAMPLE_RATE=1
# Optional: remote error sink (future integration)
ERROR_SINK_DSN=
ALERT_WEBHOOK_URL=
SESSION_COOKIE_NAME=scarabev_session
CSRF_COOKIE_NAME=scarabev_csrf
SESSION_TTL_SECONDS=28800
SESSION_ROTATION_SECONDS=1800
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_USER=15
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT_PER_IP=240
ADMIN_RATE_LIMIT_PER_USER=120
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=14
BACKUP_REQUIRE_EXTERNAL=false
BACKUP_OBJECT_PREFIX=snapshots
BACKUP_CRON_ENABLED=false
MARKET_WORKER_URL=https://scarabev-market-worker-staging.paperpandastacks.workers.dev
SESSION_API_BASE_URL=https://scarabev-api-staging.paperpandastacks.workers.dev/admin/sessions
D1_RESOURCE_LABEL=scarabev-backend-dev
BACKUP_R2_BUCKET_LABEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MARKET_WORKER_ADMIN_TOKEN=
STAGING_REFRESH_SOURCE_D1_ID=
STAGING_REFRESH_SOURCE_D1_LABEL=scarabev-backend-production
STAGING_REFRESH_SOURCE_KV_NAMESPACE_ID=
STAGING_REFRESH_SOURCE_KV_NAMESPACE_LABEL=ev-history-production
STAGING_REFRESH_TARGET_KV_NAMESPACE_ID=
STAGING_REFRESH_TARGET_KV_NAMESPACE_LABEL=ev-history-staging
